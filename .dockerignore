# Dependencies
**/node_modules/
**/.next/
**/dist/
**/.pnp
**/.pnp.js

# Environment files (use .env.docker or docker-compose .env)
**/.env
**/.env.local
**/.env.*.local

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore
.gitattributes

# OS
.DS_Store
Thumbs.db

# Python / Janus (not part of Docker deployment)
Janus/
**/__pycache__/
**/*.pyc
**/.venv/
**/.hypothesis/
**/.pytest_cache/
**/*.egg-info/

# Uploads (mounted as volume)
**/uploads/

# Build artifacts
*.log
*.tgz
*.tar.gz

# Docker (don't include self)
.dockerignore
docker-compose*.yml
Dockerfile*

# CI/CD (not needed in images)
.github/

# Test / Coverage
coverage/
.nyc_output/

# Misc
*.md
!README.md
