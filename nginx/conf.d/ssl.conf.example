# ============================================================
# Cloudflare SSL 说明
# ============================================================
#
# 本项目使用 Cloudflare Tunnel，SSL 由 Cloudflare 处理：
#   - 用户 ↔ Cloudflare：Cloudflare 自动签发/续期 SSL 证书
#   - Cloudflare ↔ 服务器：通过加密 Tunnel（无需 nginx SSL）
#
# 因此 nginx 不需要配置 SSL，仅处理内部 HTTP 流量。
#
# Cloudflare SSL 模式设置（Cloudflare Dashboard → SSL/TLS）：
#   推荐：Full (strict) — 最安全
#   备选：Full        — 如果使用的是 Cloudflare Origin CA 证书
#   不推荐：Flexible   — 用户到 CF 加密但 CF 到源明文（Tunnel 已加密此段）
#
# ============================================================
# 如需开启 HTTP → HTTPS 重定向（在 Cloudflare 侧配置更推荐）：
# ============================================================
#
# Cloudflare Dashboard → SSL/TLS → Edge Certificates：
#   ✅ Always Use HTTPS
#   ✅ Automatic HTTPS Rewrites
#
# 以下为传统的 nginx SSL 终止配置（备选，当前未启用）：

# server {
#   listen 443 ssl http2;
#   listen [::]:443 ssl http2;
#   server_name _;
#
#   ssl_certificate     /etc/nginx/ssl/fullchain.pem;
#   ssl_certificate_key /etc/nginx/ssl/privkey.pem;
#
#   ssl_protocols TLSv1.2 TLSv1.3;
#   ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
#   ssl_prefer_server_ciphers off;
#
#   # ... 其余配置同 HTTP server
# }
