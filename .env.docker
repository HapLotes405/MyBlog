# ===== Docker Compose 环境变量 =====
# 复制此文件为 .env 并根据需要修改

# 数据库配置
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=wiki

# 后端端口（宿主机）
BACKEND_PORT=8000

# JWT 密钥（生产环境务必修改为随机字符串）
JWT_SECRET=change-me-use-openssl-rand-hex-32

# 博主账号（注册时使用此邮箱自动获得博主权限）
BLOGGER_EMAIL=admin@hapLotes405.wiki
BLOGGER_PASSWORD=changeme

# CORS 允许的前端域名（逗号分隔）
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# 前端端口（宿主机）
FRONTEND_PORT=3000

# 前端访问后端的 API 地址（浏览器端使用）
# 开发环境：直接访问后端端口
# 生产环境（通过 nginx）：使用相对路径 /api 或域名
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Nginx HTTP 端口（宿主机）
NGINX_HTTP_PORT=80

# Nginx HTTPS 端口（宿主机）
NGINX_HTTPS_PORT=443

# 生产域名（用于 CORS 和 SSL）
DOMAIN=example.com
