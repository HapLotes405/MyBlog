# cloudflared credentials.json
# 此文件由 cloudflared tunnel create 命令自动生成。
#
# 获取方式：
#   1. 在本地安装 cloudflared: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
#   2. cloudflared tunnel login
#   3. cloudflared tunnel create wiki-tunnel
#   4. 将 ~/.cloudflared/<TUNNEL_ID>.json 内容复制到此文件
#
# 或者：直接使用 Token 方式（推荐），无需此文件。
#   将 token 写入 .env 的 CF_TUNNEL_TOKEN 即可，
#   Docker 容器会使用 token 自动认证。
#
# {
#   "AccountTag": "abc123...",
#   "TunnelSecret": "xyz789...",
#   "TunnelID": "12345678-1234-1234-1234-123456789abc"
# }
